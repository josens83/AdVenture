# ===========================================
# 마케터 생존기 환경 변수 설정
# ===========================================

# 사이트 URL (프로덕션에서는 실제 도메인으로 변경)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# 데이터베이스 (PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/adventure?schema=public"

# ===========================================
# NextAuth 인증
# ===========================================
# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (선택)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (선택)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# Stripe 결제
# ===========================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (Stripe 대시보드에서 생성)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# ===========================================
# 이메일 (SMTP)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="마케터 생존기 <noreply@marketer-survival.com>"

# ===========================================
# Redis (Rate Limiting - 선택)
# ===========================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# 보안
# ===========================================
# openssl rand -base64 32 로 생성
CSRF_SECRET=your-csrf-secret-key-here

# ===========================================
# SEO & 분석 (선택)
# ===========================================
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# 관리자 설정
# ===========================================
# 관리자 이메일 주소 (쉼표로 구분)
ADMIN_EMAILS=admin@example.com

# ===========================================
# 크론 작업
# ===========================================
# 크론 작업 인증 토큰 (openssl rand -base64 32 로 생성)
CRON_SECRET=your-cron-secret-key-here

# ===========================================
# 개발 환경 전용
# ===========================================
# 환경 검증 건너뛰기 (빌드 시에만 사용)
SKIP_ENV_VALIDATION=false

# Prisma 엔진 체크섬 무시 (오프라인 환경)
# PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
