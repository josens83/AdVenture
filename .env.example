# ==============================================
# 마케터 생존기 환경 변수 설정
# ==============================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/adventure

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-key-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (at least one required for OAuth login)
# Google OAuth - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Stripe Configuration - https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_monthly
STRIPE_STARTER_YEARLY_PRICE_ID=price_starter_yearly
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_monthly
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_yearly

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cron Job Secret (for scheduled tasks like leaderboard updates)
CRON_SECRET=your-cron-secret-key

# ==============================================
# Optional: Production Settings
# ==============================================

# Vercel KV (for rate limiting, caching)
# KV_URL=your-kv-url
# KV_REST_API_URL=your-kv-rest-api-url
# KV_REST_API_TOKEN=your-kv-rest-api-token
# KV_REST_API_READ_ONLY_TOKEN=your-kv-read-only-token

# Sentry (for error tracking)
# SENTRY_DSN=your-sentry-dsn
# SENTRY_ORG=your-org
# SENTRY_PROJECT=adventure

# Email (for transactional emails)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=noreply@your-domain.com
